# macOS
.DS_Store

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/

# Editors
.vscode/
.idea/

# LaTeX build files (keep .tex and the final .pdf)
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls

# Put large trajectories/checkpoints (>~50 MB) here so they stay local
large/

# Run outputs: everything stays on disk; git keeps only inputs/metadata
# (in.json, settings.json, run_info.json) and the compressed dipole.dat.gz +
# energy.dat.gz that run.py writes, which is enough to regenerate spectra and plots.
# (Runs committed before 2026-10-02 still have their .dat files tracked.)
runs/**/*.dat
runs/**/*.traj
runs/**/*.log
runs/**/velocities.xyz
